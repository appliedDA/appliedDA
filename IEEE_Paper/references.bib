@INPROCEEDINGS{10852447,
  author={Gehrmann, Julia and Quakulinski, Lars and Beyan, Oya},
  booktitle={2024 2nd International Conference on Foundation and Large Language Models (FLLM)}, 
  title={Large Language Models for Literature Reviews - An Exemplary Comparison of LLM-based Approaches with Manual Methods}, 
  year={2024},
  volume={},
  number={},
  pages={385-391},
  abstract={Large Language Models (LLMs) and LLM-based tools are increasingly popular for various tasks, including literature reviews. This trend holds significant potential in fields like healthcare and medical informatics, where timely updates on new research findings can have life-saving implications. However, the sensitive nature of these fields demands high reliability and trustworthiness. In this study, we assess the suitability of widely used LLM-based tools for conducting literature reviews in healthcare and medical informatics across two scenarios. First, we evaluated the tools’ performance and reliability in executing a systematic, scientific literature review by replicating the exact methodology of a recently accepted review we conducted. Second, we explored the tools’ effectiveness in quickly retrieving relevant information by testing their responses to differently phrased queries, focusing on the neutrality and balance of the information provided. Our findings indicate that while LLM-based tools can offer a useful initial overview of an unfamiliar topic, they are less effective for in-depth literature reviews. Furthermore, the choice of the specific tool is critical, as significant differences were observed in both the generated text and the references provided across tools. Additionally, our results suggest that prompts crafted in a scientific style with a negative connotation towards the research hypothesis tend to result in more balanced discussions compared to those framed in everyday language with a positive connotation towards the research hypothesis.},
  keywords={Systematics;Large language models;Medical services;Manuals;Market research;Reliability;Prompt engineering;Informatics;Systematic literature review;Testing;Large Language Model;LLM;Chatbots;Literature Review;Medical Informatics},
  doi={10.1109/FLLM63129.2024.10852447},
  ISSN={},
  month={Nov},}

